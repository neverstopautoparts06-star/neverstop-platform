// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockLocationType {
  STORE
  WAREHOUSE
}

enum InstallAxle {
  FRONT
  REAR
  OTHER
}

enum InstallSide {
  LEFT
  RIGHT
  BOTH
  NA
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CONVERTED
  CLOSED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  VERIFICATION_REQUIRED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  COD
  MOCK_QR
  PAYOS
  BANK_TRANSFER
  VIETQR
  ZALOPAY
  MOMO
  VNPAY
  CARD
  OTHER
}

model VehicleBrand {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  isActive  Boolean        @default(true)
  models    VehicleModel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model VehicleModel {
  id       String  @id @default(cuid())
  brandId  String
  name     String
  slug     String
  isActive Boolean @default(true)

  brand    VehicleBrand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants VehicleVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, name])
  @@unique([brandId, slug])
  @@index([name])
}

model VehicleVariant {
  id             String  @id @default(cuid())
  vehicleModelId String
  modelCode      String?
  yearFrom       Int
  yearTo         Int?
  displayName    String?
  isActive       Boolean @default(true)

  vehicleModel VehicleModel     @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  fitments     ProductFitment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modelCode])
  @@index([yearFrom, yearTo])
}

model ProductCategory {
  id       String  @id @default(cuid())
  nameVi   String
  nameEn   String?
  nameZh   String?
  slug     String  @unique
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id         String @id @default(cuid())
  partNumber String @unique
  slug       String @unique

  nameVi String
  nameEn String?
  nameZh String?

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  axle InstallAxle?
  side InstallSide?

  descriptionVi String?
  descriptionEn String?
  descriptionZh String?

  netWeightKg   Decimal? @db.Decimal(10, 3)
  grossWeightKg Decimal? @db.Decimal(10, 3)

  piecesPerCarton Int?
  cartonLengthCm  Decimal? @db.Decimal(10, 2)
  cartonWidthCm   Decimal? @db.Decimal(10, 2)
  cartonHeightCm  Decimal? @db.Decimal(10, 2)

  retailPrice1 Decimal? @db.Decimal(14, 0)
  retailPrice2 Decimal? @db.Decimal(14, 0)

  status ProductStatus @default(ACTIVE)

  seoTitle       String?
  seoDescription String?

  images       ProductImage[]
  oeNumbers    ProductOeNumber[]
  fitments     ProductFitment[]
  inventory    InventoryBalance[]
  inquiryItems InquiryItem[]
  quoteItems   QuoteItem[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nameVi])
  @@index([partNumber])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model OeNumber {
  id        String            @id @default(cuid())
  number    String            @unique
  products  ProductOeNumber[]
  createdAt DateTime          @default(now())

  @@index([number])
}

model ProductOeNumber {
  productId  String
  oeNumberId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oeNumber OeNumber @relation(fields: [oeNumberId], references: [id], onDelete: Cascade)

  @@id([productId, oeNumberId])
}

model ProductFitment {
  id               String  @id @default(cuid())
  productId        String
  vehicleVariantId String
  notes            String?

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleVariant VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([productId, vehicleVariantId])
  @@index([vehicleVariantId])
}

model InventoryLocation {
  id       String            @id @default(cuid())
  code     String            @unique
  name     String
  type     StockLocationType
  isActive Boolean           @default(true)

  balances InventoryBalance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryBalance {
  id         String @id @default(cuid())
  productId  String
  locationId String

  quantity         Int @default(0)
  reservedQuantity Int @default(0)

  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([productId, locationId])
}

model Customer {
  id    String  @id @default(cuid())
  name  String?
  phone String?
  zalo  String?
  email String?
  notes String?

  inquiries Inquiry[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model Inquiry {
  id            String @id @default(cuid())
  inquiryNumber String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName String?
  phone        String?
  zalo         String?

  vehicleBrand   String?
  vehicleModel   String?
  modelCode      String?
  productionYear Int?

  notes  String?
  status InquiryStatus @default(NEW)

  items InquiryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InquiryItem {
  id        String  @id @default(cuid())
  inquiryId String
  productId String?
  quantity  Int     @default(1)
  note      String?

  inquiry Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Order {
  quoteId               String?        @unique
  quote                 Quote?         @relation(fields: [quoteId], references: [id])
  publicToken           String?        @unique
  customerType          CustomerType?
  discount              Decimal        @default(0) @db.Decimal(14, 0)
  warrantyTermsSnapshot String?
  vehicleInfo           String?
  city                  String?
  paymentMethod         PaymentMethod?
  inventoryTask         InventoryTask?
  id                    String         @id @default(cuid())
  orderNumber           String         @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName    String?
  phone           String?
  zalo            String?
  shippingAddress String?

  status        OrderStatus   @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)

  subtotal    Decimal @default(0) @db.Decimal(14, 0)
  shippingFee Decimal @default(0) @db.Decimal(14, 0)
  totalAmount Decimal @default(0) @db.Decimal(14, 0)

  customerNote String?
  internalNote String?

  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  partNumber  String?
  productName String?
  oeNumber    String?
  vehicleInfo String?
  axle        InstallAxle?
  side        InstallSide?
  id          String       @id @default(cuid())
  orderId     String
  productId   String

  quantity  Int
  unitPrice Decimal @db.Decimal(14, 0)
  lineTotal Decimal @db.Decimal(14, 0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Payment {
  id                String    @id @default(cuid())
  quoteId           String?   @unique
  quote             Quote?    @relation(fields: [quoteId], references: [id])
  publicToken       String?   @unique
  provider          String?
  providerPaymentId String?   @unique
  paidAt            DateTime?
  orderId           String?

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount Decimal @db.Decimal(14, 0)

  paymentReference      String?
  providerTransactionId String?
  bankReference         String?

  confirmedAt  DateTime?
  confirmedBy  String?
  internalNote String?

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([paymentReference])
}

enum CustomerType {
  B2B
  B2C
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  PAYMENT_PENDING
  PAID
  COD_CONFIRMED
  EXPIRED
  CANCELLED
}

model Quote {
  id                    String       @id @default(cuid())
  quoteNumber           String       @unique
  publicToken           String       @unique
  customerType          CustomerType
  customerName          String
  phone                 String
  zalo                  String?
  city                  String?
  address               String?
  vehicleBrand          String?
  vehicleModel          String?
  vehicleYear           String?
  vehicleCode           String?
  subtotal              Decimal      @db.Decimal(14, 0)
  shippingFee           Decimal      @default(0) @db.Decimal(14, 0)
  discount              Decimal      @default(0) @db.Decimal(14, 0)
  totalAmount           Decimal      @db.Decimal(14, 0)
  status                QuoteStatus  @default(DRAFT)
  validUntil            DateTime
  warrantyTermsSnapshot String
  customerNote          String?
  internalNote          String?
  codEligible           Boolean      @default(false)
  onlinePaymentEnabled  Boolean      @default(false)
  acceptedAt            DateTime?
  revisionOfId          String?
  revisionOf            Quote?       @relation("QuoteRevision", fields: [revisionOfId], references: [id])
  revisions             Quote[]      @relation("QuoteRevision")
  items                 QuoteItem[]
  order                 Order?
  payment               Payment?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([status, customerType, createdAt])
}

model QuoteItem {
  id          String       @id @default(cuid())
  quoteId     String
  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  partNumber  String
  productName String
  oeNumber    String?
  vehicleInfo String?
  axle        InstallAxle?
  side        InstallSide?
  quantity    Int
  unitPrice   Decimal      @db.Decimal(14, 0)
  lineTotal   Decimal      @db.Decimal(14, 0)

  @@index([quoteId])
}

// Durable hand-off: stock is not deducted until the existing fulfilment process
// explicitly handles this task. No new reservation algorithm is imposed here.
model InventoryTask {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  status      String    @default("PENDING_REVIEW")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}
