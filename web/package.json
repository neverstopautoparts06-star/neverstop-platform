{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "prebuild": "prisma generate",
    "test:catalog": "tsx scripts/test-catalog.ts",
    "test:website": "tsx scripts/test-website.ts",
    "dev:local": "next dev --webpack --hostname 127.0.0.1 --port 3006",
    "db:local": "node scripts/local-db.mjs",
